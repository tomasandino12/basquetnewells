{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "xlsx": ["../public/vendor/xlsx.mjs"], "@datos/*": ["../src/data/*"], "@ui/*": ["../src/ui/*"], "@parser/*": ["../src/parser/*"] }
  },
  "include": ["src"]
}
